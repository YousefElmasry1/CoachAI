# CoachAI's development/runtime database is local PostgreSQL. Copy this file
# to .env and replace <PASSWORD>; never commit the populated .env file.
DATABASE_URL=postgresql+psycopg2://coachai_user:<PASSWORD>@127.0.0.1:5432/coachai

# CoachAI push providers are disabled unless explicitly enabled.
# Never commit service-account JSON files, APNs .p8 files, or device tokens.

COACHAI_FCM_ENABLED=false
COACHAI_FCM_CREDENTIALS=C:/secure/path/firebase-service-account.json
COACHAI_FCM_PROJECT_ID=your-firebase-project-id
COACHAI_FCM_DRY_RUN=false

COACHAI_APNS_ENABLED=false
COACHAI_APNS_ENVIRONMENT=sandbox
COACHAI_APNS_KEY_ID=YOUR_KEY_ID
COACHAI_APNS_TEAM_ID=YOUR_TEAM_ID
COACHAI_APNS_BUNDLE_ID=com.example.coachai
COACHAI_APNS_PRIVATE_KEY=C:/secure/path/AuthKey_KEYID.p8

COACHAI_PUSH_TIMEOUT_SECONDS=10
