# Legacy/local SQLite files -- never commit real or stale application data.
# PostgreSQL is the documented runtime; explicit SQLite URLs remain useful for
# isolated tests. The old coach_ai.db is retained only as an ignored backup.
*.db
*.db-journal
*.sqlite
*.sqlite3

# OAuth / credential artifacts that must never be committed.
*.pem
*.key
*.p8
credentials.json
*service-account*.json
firebase-adminsdk-*.json
token.json
*.token
/credentials/
/secrets/
